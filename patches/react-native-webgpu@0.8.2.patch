diff --git a/cpp/rnwgpu/api/GPUDispatchList.h b/cpp/rnwgpu/api/GPUDispatchList.h
new file mode 100644
index 0000000..c1e4beb
--- /dev/null
+++ b/cpp/rnwgpu/api/GPUDispatchList.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "Unions.h"
+
+#include "NativeObject.h"
+
+#include "webgpu/webgpu_cpp.h"
+
+namespace rnwgpu {
+
+namespace jsi = facebook::jsi;
+
+/**
+ * LIGHTDEMO PATCH: an immutable, pre-resolved list of compute dispatches
+ * (pipeline + bind group + workgroup counts). Built once via
+ * GPUDevice.createDispatchList() and replayed each frame with
+ * GPUComputePassEncoder.executeDispatchList() - the per-frame cost is a
+ * single JSI call instead of 3 calls per dispatch (measured ~6ms/frame of
+ * Hermes/JSI overhead for ~850 dispatches in LightDemo).
+ */
+class GPUDispatchList : public NativeObject<GPUDispatchList> {
+public:
+  static constexpr const char *CLASS_NAME = "GPUDispatchList";
+
+  struct Entry {
+    wgpu::ComputePipeline pipeline;
+    wgpu::BindGroup bindGroup;
+    uint32_t x;
+    uint32_t y;
+    uint32_t z;
+  };
+
+  explicit GPUDispatchList(std::vector<Entry> entries, std::string label)
+      : NativeObject(CLASS_NAME), _entries(std::move(entries)),
+        _label(std::move(label)) {}
+
+public:
+  std::string getBrand() { return CLASS_NAME; }
+
+  double getCount() { return static_cast<double>(_entries.size()); }
+
+  std::string getLabel() { return _label; }
+  void setLabel(const std::string &label) { _label = label; }
+
+  static void definePrototype(jsi::Runtime &runtime, jsi::Object &prototype) {
+    installGetter(runtime, prototype, "__brand", &GPUDispatchList::getBrand);
+    installGetter(runtime, prototype, "count", &GPUDispatchList::getCount);
+    installGetterSetter(runtime, prototype, "label", &GPUDispatchList::getLabel,
+                        &GPUDispatchList::setLabel);
+  }
+
+  inline const std::vector<Entry> &get() { return _entries; }
+
+private:
+  std::vector<Entry> _entries;
+  std::string _label;
+};
+
+} // namespace rnwgpu
diff --git a/cpp/rnwgpu/api/descriptors/GPUDispatchItem.h b/cpp/rnwgpu/api/descriptors/GPUDispatchItem.h
new file mode 100644
index 0000000..471b619
--- /dev/null
+++ b/cpp/rnwgpu/api/descriptors/GPUDispatchItem.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "JSIConverter.h"
+#include "WGPULogger.h"
+
+#include "GPUBindGroup.h"
+#include "GPUComputePipeline.h"
+
+namespace jsi = facebook::jsi;
+
+namespace rnwgpu {
+
+/**
+ * LIGHTDEMO PATCH: one element of GPUDevice.createDispatchList()'s input -
+ * {pipeline, bindGroup, x, y?, z?}.
+ */
+struct GPUDispatchItem {
+  std::shared_ptr<GPUComputePipeline> pipeline; // GPUComputePipeline
+  std::shared_ptr<GPUBindGroup> bindGroup;      // GPUBindGroup
+  double x = 1;                                 // GPUSize32
+  std::optional<double> y;                      // GPUSize32
+  std::optional<double> z;                      // GPUSize32
+};
+
+} // namespace rnwgpu
+
+namespace rnwgpu {
+
+template <> struct JSIConverter<std::shared_ptr<rnwgpu::GPUDispatchItem>> {
+  static std::shared_ptr<rnwgpu::GPUDispatchItem>
+  fromJSI(jsi::Runtime &runtime, const jsi::Value &arg, bool outOfBounds) {
+    auto result = std::make_unique<rnwgpu::GPUDispatchItem>();
+    if (!outOfBounds && arg.isObject()) {
+      auto value = arg.getObject(runtime);
+      if (value.hasProperty(runtime, "pipeline")) {
+        auto prop = value.getProperty(runtime, "pipeline");
+        result->pipeline =
+            JSIConverter<std::shared_ptr<GPUComputePipeline>>::fromJSI(
+                runtime, prop, false);
+      }
+      if (value.hasProperty(runtime, "bindGroup")) {
+        auto prop = value.getProperty(runtime, "bindGroup");
+        result->bindGroup = JSIConverter<std::shared_ptr<GPUBindGroup>>::fromJSI(
+            runtime, prop, false);
+      }
+      if (value.hasProperty(runtime, "x")) {
+        auto prop = value.getProperty(runtime, "x");
+        result->x = JSIConverter<double>::fromJSI(runtime, prop, false);
+      }
+      if (value.hasProperty(runtime, "y")) {
+        auto prop = value.getProperty(runtime, "y");
+        result->y =
+            JSIConverter<std::optional<double>>::fromJSI(runtime, prop, false);
+      }
+      if (value.hasProperty(runtime, "z")) {
+        auto prop = value.getProperty(runtime, "z");
+        result->z =
+            JSIConverter<std::optional<double>>::fromJSI(runtime, prop, false);
+      }
+    }
+
+    return result;
+  }
+  static jsi::Value toJSI(jsi::Runtime &runtime,
+                          std::shared_ptr<rnwgpu::GPUDispatchItem> arg) {
+    throw std::runtime_error("Invalid GPUDispatchItem::toJSI()");
+  }
+};
+
+} // namespace rnwgpu
