+// LIGHTDEMO PATCH: replay a prebuilt dispatch list with zero per-dispatch
+// JSI cost. Redundant SetPipeline calls (consecutive entries sharing a
+// pipeline) are skipped.
+void GPUComputePassEncoder::executeDispatchList(
+    std::shared_ptr<GPUDispatchList> list) {
+  WGPUComputePipeline last = nullptr;
+  for (const auto &entry : list->get()) {
+    if (entry.pipeline.Get() != last) {
+      _instance.SetPipeline(entry.pipeline);
+      last = entry.pipeline.Get();
+    }
+    _instance.SetBindGroup(0, entry.bindGroup);
+    _instance.DispatchWorkgroups(entry.x, entry.y, entry.z);
+  }
+}
+
 } // namespace rnwgpu
