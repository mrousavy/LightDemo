+// LIGHTDEMO PATCH: resolve the JS array of {pipeline, bindGroup, x, y, z}
+// ONCE into wgpu handles - executeDispatchList replays it with zero JSI.
+std::shared_ptr<GPUDispatchList> GPUDevice::createDispatchList(
+    std::vector<std::shared_ptr<GPUDispatchItem>> items) {
+  std::vector<GPUDispatchList::Entry> entries;
+  entries.reserve(items.size());
+  for (auto &item : items) {
+    if (!item || !item->pipeline || !item->bindGroup) {
+      throw std::runtime_error("GPUDevice::createDispatchList(): every item "
+                               "needs a pipeline and a bindGroup");
+    }
+    entries.push_back(GPUDispatchList::Entry{
+        item->pipeline->get(), item->bindGroup->get(),
+        static_cast<uint32_t>(item->x),
+        static_cast<uint32_t>(item->y.value_or(1)),
+        static_cast<uint32_t>(item->z.value_or(1))});
+  }
+  return std::make_shared<GPUDispatchList>(std::move(entries), "");
+}
