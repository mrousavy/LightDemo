{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["lightnative"],
  "ios": {
    "iosModuleName": "NitroLightNative"
  },
  "android": {
    "androidNamespace": ["lightnative"],
    "androidCxxLibName": "NitroLightNative"
  },
  "autolinking": {
    "LightNative": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridLightNative"
      }
    }
  },
  "ignorePaths": ["node_modules", "lib"]
}
